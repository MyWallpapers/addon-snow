{
  "runtime": "canvas-v1",
  "name": "Snow",
  "description": "Des flocons légers, à des profondeurs différentes. Une chute lente et silencieuse.",
  "version": "0.1.0",
  "entry": "dist/assets/addon.js",
  "thumbnail": "assets/thumbnail.png",
  "deviceSettingsVersion": "1",
  "ui": {
    "pointerEvents": "none"
  },
  "settings": [
    {
      "id": "color",
      "type": "color",
      "label": "Flocons",
      "default": "#e0e7e6"
    },
    {
      "id": "density",
      "type": "range",
      "label": "Flocons",
      "default": 70,
      "min": 10,
      "max": 180,
      "step": 1
    },
    {
      "id": "speed",
      "type": "range",
      "label": "Vitesse",
      "default": 1,
      "min": 0.2,
      "max": 3,
      "step": 0.1
    },
    {
      "id": "size",
      "type": "range",
      "label": "Taille",
      "default": 3,
      "min": 1,
      "max": 8,
      "step": 0.5
    },
    {
      "id": "motion",
      "type": "boolean",
      "label": "Animation",
      "default": true
    }
  ]
}
